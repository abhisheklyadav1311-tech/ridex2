# ═══════════════════════════════════════════════════════
#   RideX Backend — Environment Variables
#   Copy this file to .env and fill in your values
# ═══════════════════════════════════════════════════════

# ─── Server ───────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ─── JWT Secret ───────────────────────────────────────
# REQUIRED: Generate with command below and paste here:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=anylongrandomtexthere123456789abcdefgh
JWT_EXPIRES_IN=7d

# ─── Admin Setup ──────────────────────────────────────
# Admin account is auto-created on first run
ADMIN_EMAIL=yaduvanshi8584@gmail.com
ADMIN_PASSWORD=Abhi@5378

# ─── Frontend URL (for CORS) ──────────────────────────
# Local dev:
FRONTEND_URL=http://localhost:5173
# After deploying frontend, change to:
# FRONTEND_URL=https://your-ridex-app.vercel.app

# ─── Google Maps (OPTIONAL) ───────────────────────────
# App works WITHOUT this using smart distance estimation.
# For REAL GPS distances, get a free key at:
#   https://console.cloud.google.com → Enable Distance Matrix API
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here
